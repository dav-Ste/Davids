    classDef shared fill:#1e1b4b,stroke:#a78bfa,stroke-width:2px,color:#f8fafc
    classDef data fill:#271a0c,stroke:#fbbf24,stroke-width:2px,color:#fef3c7
    classDef obs fill:#042f2e,stroke:#2dd4bf,stroke-width:2px,color:#f0fdfa
    classDef gate fill:#2e1065,stroke:#f472b6,stroke-width:2px,color:#fdf4ff

    class CustClient,AdminBrowser,IstioEdge edge
    class GW gateway
    class IdSvc,AdminIdSvc,CustSvc,FESvc service
    class Shared shared
    class DbId,DbAdmin,DbCust,Redis,Rabbit,Vault data
    class Prom,Jaeger,Grafana,Seq obs
    class S1,S2,S3,S4,S5 gate
