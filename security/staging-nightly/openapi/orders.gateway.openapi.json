{
  "openapi": "3.1.1",
  "info": {
    "title": "Davids Orders API",
    "description": "Customer checkout, order history, and workforce order inspection endpoints.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "description": "Davids YARP API Gateway",
      "url": "http://localhost:17320"
    }
  ],
  "paths": {
    "/orders/checkout": {
      "post": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetailsDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this order resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/orders/me": {
      "get": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "maximum": 200,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderSummaryDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this order resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/orders/me/{orderId}": {
      "get": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetailsDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this order resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/orders/me/{orderId}/cancel": {
      "post": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetailsDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this order resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "pattern": "^[^\\u0000]*$",
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "maxLength": 40,
              "pattern": "^[^\\u0000]*$",
              "type": "string"
            }
          },
          {
            "name": "customerId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderSummaryDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this order resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/orders/{orderId}": {
      "get": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetailsDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this order resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CheckoutOrder": {
        "required": [
          "shippingFullName",
          "shippingAddress"
        ],
        "type": "object",
        "properties": {
          "shippingFullName": {
            "maxLength": 120,
            "minLength": 2,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "shippingAddress": {
            "maxLength": 300,
            "minLength": 5,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "paymentMethod": {
            "enum": [
              null,
              "card",
              "wallet",
              "invoice"
            ],
            "type": [
              "null",
              "string"
            ],
            "default": "card"
          },
          "cardLast4": {
            "maxLength": 4,
            "minLength": 4,
            "pattern": "^[0-9]{4}$",
            "type": [
              "null",
              "string"
            ],
            "default": "4242"
          }
        }
      },
      "OrderDetailsDto": {
        "required": [
          "id",
          "customerId",
          "customerEmail",
          "shippingFullName",
          "shippingAddress",
          "totalAmount",
          "currency",
          "status",
          "paymentMethod",
          "cardLast4",
          "paymentId",
          "paymentReference",
          "failureReason",
          "createdAt",
          "updatedAt",
          "completedAt",
          "items"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "customerEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "shippingFullName": {
            "type": "string"
          },
          "shippingAddress": {
            "type": "string"
          },
          "totalAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string"
          },
          "cardLast4": {
            "type": "string"
          },
          "paymentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "paymentReference": {
            "type": [
              "null",
              "string"
            ]
          },
          "failureReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemDto"
            }
          }
        }
      },
      "OrderItemDto": {
        "required": [
          "productId",
          "sku",
          "productName",
          "unitPrice",
          "currency",
          "quantity",
          "lineTotal"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "lineTotal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "OrderSummaryDto": {
        "required": [
          "id",
          "customerId",
          "customerEmail",
          "shippingFullName",
          "totalAmount",
          "currency",
          "itemCount",
          "status",
          "paymentMethod",
          "cardLast4",
          "paymentReference",
          "failureReason",
          "createdAt",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "customerEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "shippingFullName": {
            "type": "string"
          },
          "totalAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "itemCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "status": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string"
          },
          "cardLast4": {
            "type": "string"
          },
          "paymentReference": {
            "type": [
              "null",
              "string"
            ]
          },
          "failureReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "description": "RS256 OIDC access token (CustomerBearer or AdminBearer).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Davids.Services.Orders.Api"
    }
  ]
}
