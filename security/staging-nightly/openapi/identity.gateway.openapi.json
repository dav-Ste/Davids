{
  "openapi": "3.1.1",
  "info": {
    "title": "Davids Customer Identity OIDC API",
    "description": "Self-hosted OAuth 2.1 / OpenID Connect customer authority (RS256 + PKCE S256) and profile endpoints.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "description": "Davids YARP API Gateway",
      "url": "http://localhost:17320"
    }
  ],
  "paths": {
    "/identity/connect/token": {
      "post": {
        "tags": [
          "Davids.Services.Identity.Api"
        ],
        "summary": "Exchange an OAuth 2.1 authorization code (+ PKCE verifier) or refresh token.",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "grant_type",
                  "client_id"
                ],
                "type": "object",
                "properties": {
                  "grant_type": {
                    "enum": [
                      "authorization_code",
                      "refresh_token"
                    ],
                    "type": "string"
                  },
                  "client_id": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  "code": {
                    "maxLength": 2048,
                    "type": "string"
                  },
                  "redirect_uri": {
                    "maxLength": 512,
                    "type": "string",
                    "format": "uri"
                  },
                  "code_verifier": {
                    "maxLength": 128,
                    "minLength": 43,
                    "type": "string"
                  },
                  "refresh_token": {
                    "maxLength": 2048,
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        }
      }
    },
    "/identity/connect/userinfo": {
      "get": {
        "tags": [
          "Davids.Services.Identity.Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing, invalid, or revoked Bearer access token."
          },
          "403": {
            "description": "Authenticated caller is not authorized for this resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
