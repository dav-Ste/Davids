  "components": {
    "schemas": {
      "ChangeCustomerEmail": {
        "required": [
          "currentPassword",
          "newEmail"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "newEmail": {
            "maxLength": 254,
            "minLength": 6,
            "pattern": "^[A-Za-z0-9_%+\\-]{1,20}(?:\\.[A-Za-z0-9_%+\\-]{1,20}){0,2}@(?:[A-Za-z0-9](?:[A-Za-z0-9\\-]{0,30}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$",
            "type": "string"
          }
        }
      },
      "ChangeCustomerPassword": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "newPassword": {
            "maxLength": 128,
            "minLength": 12,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          }
        }
      },
      "CustomerChangeAuditDto": {
        "required": [
          "id",
          "service",
          "action",
          "targetType",
          "targetId",
          "targetLabel",
          "actorSub",
          "actorEmail",
          "actorRole",
          "actorAuthority",
          "changes",
          "correlationId",
          "occurredAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "service": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "targetType": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "targetLabel": {
            "type": [
              "null",
              "string"
            ]
          },
          "actorSub": {
            "type": "string"
          },
          "actorEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "actorRole": {
            "type": "string"
          },
          "actorAuthority": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerFieldChangeDto"
            }
          },
          "correlationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "occurredAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CustomerFieldChangeDto": {
        "required": [
          "field",
          "oldValue",
          "newValue"
        ],
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "oldValue": {
            "type": [
              "null",
              "string"
            ]
          },
          "newValue": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EmployeeUpdateCustomerEmail": {
        "required": [
          "newEmail"
        ],
        "type": "object",
        "properties": {
          "newEmail": {
            "maxLength": 254,
            "minLength": 6,
            "pattern": "^[A-Za-z0-9_%+\\-]{1,20}(?:\\.[A-Za-z0-9_%+\\-]{1,20}){0,2}@(?:[A-Za-z0-9](?:[A-Za-z0-9\\-]{0,30}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$",
            "type": "string"
          }
        }
      },
      "LoginAuditDto": {
        "required": [
          "id",
          "occurredAtUtc",
          "userId",
          "email",
          "succeeded",
          "outcome",
          "failureReason",
          "clientId",
          "clientIpAddress",
          "userAgent",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "userId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "succeeded": {
            "type": "boolean"
          },
          "outcome": {
            "type": "string"
          },
          "failureReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "clientId": {
            "type": [
              "null",
              "string"
            ]
          },
          "clientIpAddress": {
            "type": [
              "null",
              "string"
            ]
          },
          "userAgent": {
            "type": [
              "null",
              "string"
            ]
          },
          "correlationId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SignUp": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "maxLength": 254,
            "minLength": 6,
            "pattern": "^[A-Za-z0-9_%+\\-]{1,20}(?:\\.[A-Za-z0-9_%+\\-]{1,20}){0,2}@(?:[A-Za-z0-9](?:[A-Za-z0-9\\-]{0,30}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "role": {
            "enum": [
              null,
              "user"
            ],
            "type": [
              "null",
              "string"
            ]
          },
          "permissions": {
            "maxItems": 0,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lockoutEndUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "isLockedOut": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "description": "RS256 OIDC customer access token (aud: davids-services).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Davids.Services.Identity.Api"
    }
  ]
}
