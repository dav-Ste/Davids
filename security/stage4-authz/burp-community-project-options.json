{
  "target": {
    "scope": {
      "advanced_mode": true,
      "exclude": [
        {
          "enabled": true,
          "file": "^/logout$",
          "host": "^(localhost|127\\.0\\.0\\.1)$",
          "port": "^17320$",
          "protocol": "any"
        },
        {
          "enabled": true,
          "file": "^/(identity|admin-identity)/connect/(logout|revocation).*",
          "host": "^(localhost|127\\.0\\.0\\.1)$",
          "port": "^17320$",
          "protocol": "any"
        }
      ],
      "include": [
        {
          "enabled": true,
          "file": "^/.*",
          "host": "^(localhost|127\\.0\\.0\\.1)$",
          "port": "^17320$",
          "protocol": "http"
        }
      ]
    }
  },
  "proxy": {
    "request_listeners": [
      {
        "certificate_mode": "per_host",
        "listen_mode": "loopback_only",
        "listener_port": 8080,
        "running": true
      }
    ],
    "http_history_display_filter": {
      "by_ annotation": {
        "show_only_commented_items": false,
        "show_only_highlighted_items": false
      },
      "by_mime_type": {
        "show_css": false,
        "show_html": true,
        "show_images": false,
        "show_other_binary": false,
        "show_other_text": true,
        "show_script": true,
        "show_xml": true
      },
      "by_search": {
        "negative_search": false,
        "regex": false,
        "term": ""
      },
      "by_status_code": {
        "show_2xx": true,
        "show_3xx": true,
        "show_4xx": true,
        "show_5xx": true
      }
    }
  }
}
