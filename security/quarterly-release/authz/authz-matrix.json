      "path": "/customers",
      "actor": "customerA",
      "jsonBody": {
        "customerId": "{{custBId}}",
        "fullName": "IDOR Takeover Attempt",
        "address": "99 Attacker Lane"
      },
      "expectedStatuses": [403]
    },
    {
      "id": "AUTHZ-014",
      "category": "Vertical-Privilege-Escalation",
      "description": "Customer A cannot list/search all customers via GET /customers",
