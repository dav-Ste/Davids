{
  "openapi": "3.0.3",
  "info": {
    "title": "Davids Orders API",
    "description": "Customer checkout, order history, and workforce order inspection endpoints.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "description": "Davids YARP API Gateway",
      "url": "http://localhost:17320"
    }
  ],
  "paths": {
    "/orders/checkout": {
      "post": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/orders/me": {
      "get": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/orders/me/{orderId}": {
      "get": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/orders/me/{orderId}/cancel": {
      "post": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customerId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "tags": [
          "Davids.Services.Orders.Api"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckoutOrder": {
        "required": [
          "shippingFullName",
          "shippingAddress"
        ],
        "type": "object",
        "properties": {
          "shippingFullName": {
            "type": "string"
          },
          "shippingAddress": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string",
            "default": "card",
            "nullable": true
          },
          "cardLast4": {
            "type": "string",
            "default": "4242",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "description": "RS256 OIDC access token (CustomerBearer or AdminBearer).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Davids.Services.Orders.Api"
    }
  ]
}
