{
  "openapi": "3.0.3",
  "info": {
    "title": "Davids Baskets API",
    "description": "Customer shopping basket endpoints isolated by verified CustomerBearer OIDC identity.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "description": "Davids YARP API Gateway",
      "url": "http://localhost:17320"
    }
  ],
  "paths": {
    "/baskets/me": {
      "get": {
        "tags": [
          "Davids.Services.Baskets.Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasketDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 CustomerBearer access token."
          },
          "403": {
            "description": "Caller lacks customer permission for this basket resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Davids.Services.Baskets.Api"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 CustomerBearer access token."
          },
          "403": {
            "description": "Caller lacks customer permission for this basket resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/baskets/me/items": {
      "put": {
        "tags": [
          "Davids.Services.Baskets.Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertBasketItem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasketDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 CustomerBearer access token."
          },
          "403": {
            "description": "Caller lacks customer permission for this basket resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/baskets/me/items/{productId}": {
      "delete": {
        "tags": [
          "Davids.Services.Baskets.Api"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasketDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 CustomerBearer access token."
          },
          "403": {
            "description": "Caller lacks customer permission for this basket resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BasketDto": {
        "required": [
          "customerId",
          "items",
          "totalItems",
          "totalAmount",
          "currency",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketItemDto"
            }
          },
          "totalItems": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "totalAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BasketItemDto": {
        "required": [
          "productId",
          "sku",
          "productName",
          "unitPrice",
          "currency",
          "quantity",
          "lineTotal"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "lineTotal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          }
        }
      },
      "UpsertBasketItem": {
        "required": [
          "productId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "maximum": 99,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "description": "RS256 CustomerBearer OIDC access token (aud: davids-services).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Davids.Services.Baskets.Api"
    }
  ]
}
