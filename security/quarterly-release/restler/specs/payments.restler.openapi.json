{
  "openapi": "3.0.3",
  "info": {
    "title": "Davids Payments API",
    "description": "Asynchronous RabbitMQ payment capture ledger for customer orders and workforce audit.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "description": "Davids YARP API Gateway",
      "url": "http://localhost:17320"
    }
  ],
  "paths": {
    "/payments/me": {
      "get": {
        "tags": [
          "Davids.Services.Payments.Api"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "maximum": 200,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this payment resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/payments/me/order/{orderId}": {
      "get": {
        "tags": [
          "Davids.Services.Payments.Api"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this payment resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/payments": {
      "get": {
        "tags": [
          "Davids.Services.Payments.Api"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "maxLength": 40,
              "pattern": "^[^\\u0000]*$",
              "type": "string"
            }
          },
          {
            "name": "customerId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this payment resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/payments/order/{orderId}": {
      "get": {
        "tags": [
          "Davids.Services.Payments.Api"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks permission for this payment resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentDto": {
        "required": [
          "id",
          "orderId",
          "customerId",
          "amount",
          "currency",
          "paymentMethod",
          "cardLast4",
          "status",
          "providerReference",
          "failureReason",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string"
          },
          "cardLast4": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "providerReference": {
            "type": "string"
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "description": "RS256 OIDC access token (CustomerBearer or AdminBearer).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Davids.Services.Payments.Api"
    }
  ]
}
