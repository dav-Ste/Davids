{
  "openapi": "3.0.3",
  "info": {
    "title": "Davids Products API",
    "description": "Product catalog, inventory stock management, and workforce catalog change-audit endpoints.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "description": "Davids YARP API Gateway",
      "url": "http://localhost:17320"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "tags": [
          "Davids.Services.Products.Api"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "pattern": "^[^\\u0000]*$",
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "maxLength": 60,
              "pattern": "^[^\\u0000]*$",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "maximum": 200,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        }
      },
      "post": {
        "tags": [
          "Davids.Services.Products.Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProduct"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks workforce permission for this catalog resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/products/{productId}": {
      "get": {
        "tags": [
          "Davids.Services.Products.Api"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        }
      },
      "put": {
        "tags": [
          "Davids.Services.Products.Api"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProduct"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks workforce permission for this catalog resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/products/admin": {
      "get": {
        "tags": [
          "Davids.Services.Products.Api"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "pattern": "^[^\\u0000]*$",
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "maxLength": 60,
              "pattern": "^[^\\u0000]*$",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks workforce permission for this catalog resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/products/admin/{productId}": {
      "get": {
        "tags": [
          "Davids.Services.Products.Api"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks workforce permission for this catalog resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/products/{productId}/stock": {
      "post": {
        "tags": [
          "Davids.Services.Products.Api"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdjustProductStock"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks workforce permission for this catalog resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/products/change-audits": {
      "get": {
        "tags": [
          "Davids.Services.Products.Api"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductChangeAuditDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "429": {
            "description": "Rate limit exceeded."
          },
          "401": {
            "description": "Missing or invalid RS256 Bearer access token."
          },
          "403": {
            "description": "Caller lacks workforce permission for this catalog resource."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AdjustProductStock": {
        "required": [
          "delta"
        ],
        "type": "object",
        "properties": {
          "delta": {
            "maximum": 1000,
            "minimum": -1000,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "reason": {
            "maxLength": 200,
            "pattern": "^[^\\u0000]*$",
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateProduct": {
        "required": [
          "sku",
          "name",
          "description",
          "category",
          "price",
          "stockQuantity"
        ],
        "type": "object",
        "properties": {
          "sku": {
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[A-Z0-9][A-Z0-9\\-]{2,31}$",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 4,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "category": {
            "maxLength": 60,
            "minLength": 2,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "price": {
            "maximum": 1000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Z]{3}$",
            "type": "string",
            "nullable": true
          },
          "stockQuantity": {
            "maximum": 1000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "ProductChangeAuditDto": {
        "required": [
          "id",
          "productId",
          "productSku",
          "action",
          "actorSub",
          "actorEmail",
          "actorRole",
          "actorAuthority",
          "changedFieldsJson",
          "correlationId",
          "occurredAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "productSku": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "actorSub": {
            "type": "string"
          },
          "actorEmail": {
            "type": "string",
            "nullable": true
          },
          "actorRole": {
            "type": "string"
          },
          "actorAuthority": {
            "type": "string"
          },
          "changedFieldsJson": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "nullable": true
          },
          "occurredAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProductDto": {
        "required": [
          "id",
          "sku",
          "name",
          "description",
          "category",
          "price",
          "currency",
          "stockQuantity",
          "isActive",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "stockQuantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateProduct": {
        "required": [
          "name",
          "description",
          "category",
          "price",
          "stockQuantity",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 4,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "category": {
            "maxLength": 60,
            "minLength": 2,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*\\S[^\\u0000]*$",
            "type": "string"
          },
          "price": {
            "maximum": 1000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Z]{3}$",
            "type": "string",
            "nullable": true
          },
          "stockQuantity": {
            "maximum": 1000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "description": "RS256 OIDC access token (AdminBearer aud: davids-admin for workforce catalog management).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Davids.Services.Products.Api"
    }
  ]
}
